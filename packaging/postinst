#!/bin/sh
set -e
if [ "$1" = configure ]; then
    python3 -m venv /opt/dataset-studio/venv
    site_dir=$(/opt/dataset-studio/venv/bin/python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
    ln -sfn /usr/lib/python3/dist-packages/gi "$site_dir/gi"
    PYTHONNOUSERSITE=1 /opt/dataset-studio/venv/bin/python -m pip install --ignore-installed --no-index --find-links=/opt/dataset-studio/wheels 'ultralytics==8.4.166' 'flask==3.1.3' 'PyYAML==6.0.3'
fi
